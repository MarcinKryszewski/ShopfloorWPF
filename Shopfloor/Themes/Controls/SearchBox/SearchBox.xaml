<UserControl
    x:Class="Shopfloor.Themes.Controls.SearchBox.SearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shopfloor.Themes.Controls.SearchBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls/SearchBox/SearchBoxThemes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Width="300" HorizontalAlignment="Left">
        <TextBlock
            Margin="20,0"
            VerticalAlignment="Center"
            Panel.ZIndex="1"
            Foreground="#B0B9C6"
            IsHitTestVisible="False"
            Text="Search here ..."
            Visibility="{Binding ElementName=textBoxSearch, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}}" />

        <TextBox Name="textBoxSearch" Style="{StaticResource searchTextbox}" />
        <!--  Zoom  -->
        <TextBlock
            Width="18"
            Height="18"
            Margin="0,0,15,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontFamily="Segoe MDL2 Assets"
            Foreground="#B0B9C6"
            IsHitTestVisible="False"
            Style="{StaticResource pagingButtonIcon}"
            Text="&#xE71E;" />
    </Grid>
</UserControl> 