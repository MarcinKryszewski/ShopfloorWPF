<UserControl x:Class="Shopfloor.Features.ActionsList.ActionsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shopfloor.Features.ActionsList"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="White"/>
        </Style>

    </UserControl.Resources>

    <Grid MaxHeight="930">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <Style TargetType="ScrollViewer">
                <Setter Property="Margin"
                        Value="10"/>
                <!-- <Setter Property="HorizontalScrollBarVisibility"
                        Value="Auto"/> -->
                <Setter Property="VerticalScrollBarVisibility"
                        Value="Auto"/>
            </Style>
        </Grid.Resources>

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0">
                <StackPanel Width="250px"
                            Margin="10,0,0,0">

                    <TextBlock Text="Filtry"
                               Style="{StaticResource TitleTextBlock}"/>

                    <TextBlock Text="Warsztat"
                               Style="{StaticResource TooltipText}"
                               Margin="0,7,0,3"/>
                    <ComboBox Style="{StaticResource ComboBoxMain}"
                              DisplayMemberPath="Name"
                              IsEditable="true"
                              IsReadOnly="false"
                              Text="{Binding FilterData.Workshop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Path=FilterData.Workshops}"
                              IsTextSearchEnabled="false"
                              MinHeight="30px"/>

                    <TextBlock Text="Linia"
                               Style="{StaticResource TooltipText}"
                               Margin="0,7,0,3"/>
                    <ComboBox Style="{StaticResource ComboBoxMain}"
                              DisplayMemberPath="Name"
                              IsEditable="true"
                              IsReadOnly="false"
                              Text="{Binding FilterData.Line, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Path=FilterData.Lines}"
                              IsTextSearchEnabled="false"
                              MinHeight="30px"/>

                    <TextBlock Text="Maszyna"
                               Style="{StaticResource TooltipText}"
                               Margin="0,7,0,3"/>
                    <ComboBox Style="{StaticResource ComboBoxMain}"
                              DisplayMemberPath="Name"
                              IsEditable="true"
                              IsReadOnly="false"
                              Text="{Binding FilterData.Machine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Path=FilterData.Machines}"
                              MinHeight="30px"
                              IsTextSearchEnabled="false"/>

                    <TextBlock Text="Rodzaj"
                               Style="{StaticResource TooltipText}"
                               Margin="0,7,0,3"/>
                    <ComboBox Style="{StaticResource ComboBoxMain}"
                              DisplayMemberPath="Name"
                              IsEditable="true"
                              IsReadOnly="false"
                              Text="{Binding FilterData.Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Path=FilterData.Types}"
                              IsTextSearchEnabled="false"
                              MinHeight="30px"/>

                    <Grid Margin="0,7,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Style="{StaticResource CheckBoxStyle1}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding FilterData.HasInstruction}"
                                  IsThreeState="True"
                                  Grid.Column="0"
                                  Margin="2,0,0,0"/>
                        <TextBlock Text="Ma instrukcję"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource TooltipText}"/>
                    </Grid>

                    <Grid Margin="0,7,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Style="{StaticResource CheckBoxStyle1}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsThreeState="True"
                                  IsChecked="{Binding FilterData.IsPassed}"
                                  Grid.Column="0"
                                  Margin="2,0,0,0"/>
                        <TextBlock Text="Przekazana"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource TooltipText}"/>
                    </Grid>

                    <Grid Margin="0,7,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Style="{StaticResource CheckBoxStyle1}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding FilterData.IsLoto}"
                                  Grid.Column="0"
                                  Margin="2,0,0,0"/>
                        <TextBlock Text="LOTO"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource TooltipText}"/>
                    </Grid>

                    <Grid Margin="0,7,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <CheckBox Style="{StaticResource CheckBoxStyle1}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding FilterData.IsJog}"
                                  Grid.Column="0"
                                  Margin="2,0,0,0"/>
                        <TextBlock Text="JOG"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource TooltipText}"/>

                    </Grid>

                    <Grid Margin="0,7,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Style="{StaticResource CheckBoxStyle1}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding FilterData.IsProduction}"
                                  Grid.Column="0"
                                  Margin="2,0,0,0"/>
                        <TextBlock Text="Podczas produkcji"
                                   VerticalAlignment="Center"
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource TooltipText}"/>

                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <Button
                Grid.Row="2"
                Style="{StaticResource ResourceKey=ButtonMain}"
                Margin="10"
                Command="{Binding Path=CreateActionCommand}"
                Content="NOWY CILT"
                Height="50"/>
        </Grid>

        <ScrollViewer Grid.Column="1">
            <DataGrid
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Path=Activities}"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                Style="{DynamicResource DataGridMain}"
                SelectedItem="{Binding Path=Activity}"
                CellStyle="{DynamicResource DataGridCellMain}"
                ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderMain}"
                TargetUpdated="DataGrid_TargetUpdated">

                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource DataGridRowMain}"
                           TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasInstruction}"
                                         Value="True">
                                <Setter Property="BorderBrush"
                                        Value="#BAD32F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPassed}"
                                         Value="True">
                                <Setter Property="BorderBrush"
                                        Value="#2FD32F"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Machine.Line.Name}"
                                        Header="Linia"
                                        Width="auto"/>

                    <DataGridTextColumn Binding="{Binding Machine.Name}"
                                        Header="Maszyna"
                                        Width="auto"/>

                    <DataGridTextColumn Binding="{Binding Workshop.Name}"
                                        Header="Warsztat"
                                        Width="auto"/>

                    <DataGridTextColumn Binding="{Binding Type.Name}"
                                        Header="Rodzaj"
                                        Width="auto"/>

                    <DataGridTextColumn Binding="{Binding Description, NotifyOnTargetUpdated=True}"
                                        Header="Opis"
                                        Width="*"/>

                    <DataGridTextColumn Binding="{Binding OccuranceText}"
                                        Header="Częstotliwość"
                                        Width="auto"/>

                    <DataGridTextColumn Binding="{Binding Additionals}"
                                        Header="Specjalne"
                                        Width="auto"/>

                    <DataGridTemplateColumn
                        Width="auto"
                        Header="Akcje"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <Button Command="{Binding Path=DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding }"
                                            Style="{StaticResource gridConfirmButton}">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource gridButtonIcon}"
                                            Text="&#xE7B3;"/>
                                    </Button>

                                    <Button Command="{Binding Path=DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding }"
                                            Style="{StaticResource gridEditButton}">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource gridButtonIcon}"
                                            Text="&#xE70F;"/>
                                    </Button>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

            </DataGrid>
        </ScrollViewer>
    </Grid>
</UserControl> 