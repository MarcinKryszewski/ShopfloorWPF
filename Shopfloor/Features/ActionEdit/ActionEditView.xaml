<UserControl
    x:Class="Shopfloor.Features.ActionEdit.ActionEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Shopfloor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shopfloor.Features.ActionEdit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:trainings="clr-namespace:Shopfloor.Features.TrainingsList"
    d:DataContext="{d:DesignInstance Type=local:ActionEditViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ComparisonConverter x:Key="ComparisonConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlock}"
            Text="{Binding Title}" />

        <Grid
            Grid.Row="1"
            Margin="20,0,0,20"
            DataContext="{Binding Activity}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style BasedOn="{StaticResource TooltipText}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
                <Style BasedOn="{StaticResource CheckBoxStyle1}" TargetType="{x:Type CheckBox}" />
            </Grid.Resources>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Warsztat" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="Opis" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="Przekazane" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Text="Rodzaj" />
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Text="LOTO" />
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Text="Tryb JOG" />
            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                Text="Podczas produkcji" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="0"
                Text="Częstotliwość" />
            <TextBlock
                Grid.Row="8"
                Grid.Column="0"
                Text="Instrukcja wykonania" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Text="{Binding Workshop.Name}" />
            <TextBox
                Grid.Row="1"
                Grid.Column="2"
                Text="{Binding Description}" />
            <CheckBox
                Grid.Row="2"
                Grid.Column="2"
                IsChecked="{Binding IsPassed}"
                IsEnabled="True" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="2"
                Text="{Binding Type.Name}" />
            <CheckBox
                Grid.Row="4"
                Grid.Column="2"
                IsChecked="{Binding IsLoto, Mode=TwoWay}"
                IsEnabled="True" />
            <CheckBox
                Grid.Row="5"
                Grid.Column="2"
                IsChecked="{Binding IsJog, Mode=TwoWay}"
                IsEnabled="True" />
            <CheckBox
                Grid.Row="6"
                Grid.Column="2"
                IsChecked="{Binding IsDurningProduction, Mode=TwoWay}"
                IsEnabled="True" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="2"
                Text="{Binding OccuranceText}" />
            <CheckBox
                Grid.Row="8"
                Grid.Column="2"
                IsChecked="{Binding HasInstruction}"
                IsEnabled="False" />
        </Grid>

        <Grid Grid.Row="2">
            <ContentControl Content="{Binding Trainings}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type trainings:TrainingsListViewModel}">
                        <trainings:TrainingsListView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <Grid Grid.Row="3">

            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="5,15,5,20" />
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1">
                <StackPanel Orientation="Horizontal">

                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="10,0" />
                            <Setter Property="Height" Value="50" />
                            <Setter Property="Width" Value="150" />
                        </Style>
                    </StackPanel.Resources>

                    <Button
                        Width="150"
                        Height="50"
                        Margin="10,0"
                        Command="{Binding Path=SaveCommand}"
                        Content="ZAPISZ"
                        Style="{StaticResource ResourceKey=ButtonMain}" />

                    <Button
                        Width="150"
                        Height="50"
                        Margin="10,0"
                        Command="{Binding Path=CancelCommand}"
                        Content="ANULUJ"
                        Style="{StaticResource ResourceKey=ButtonEmpty}" />

                    <Button
                        Width="150"
                        Height="50"
                        Margin="10,0"
                        Command="{Binding Path=ReturnCommand}"
                        Content="WRÓĆ"
                        Style="{StaticResource ResourceKey=ButtonSide}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl> 