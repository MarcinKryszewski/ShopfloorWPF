<UserControl x:Class="Shopfloor.Features.ActionEdit.ActionEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shopfloor.Features.ActionEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   Style="{StaticResource TitleTextBlock}"/>

        <Grid Grid.Row="1"
              Margin="20,0,0,20"
              DataContext="{Binding Activity}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="{x:Type TextBlock}"
                       BasedOn="{StaticResource TooltipText}">
                    <Setter Property="Margin"
                            Value="0,0,0,10"/>
                </Style>
                <Style TargetType="{x:Type CheckBox}"
                       BasedOn="{StaticResource CheckBoxStyle1}"/>
            </Grid.Resources>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Warsztat"/>
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Opis"/>
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Przekazane"/>
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Rodzaj"/>
            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="LOTO"/>
            <TextBlock Grid.Row="5"
                       Grid.Column="0"
                       Text="Tryb JOG"/>
            <TextBlock Grid.Row="6"
                       Grid.Column="0"
                       Text="Podczas produkcji"/>
            <TextBlock Grid.Row="7"
                       Grid.Column="0"
                       Text="Częstotliwość"/>
            <TextBlock Grid.Row="8"
                       Grid.Column="0"
                       Text="Instrukcja wykonania"/>

            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Text="{Binding Workshop.Name}"/>
            <TextBox Grid.Row="1"
                     Grid.Column="2"
                     Text="{Binding Description}"/>
            <CheckBox Grid.Row="2"
                      Grid.Column="2"
                      IsEnabled="True"
                      IsChecked="{Binding IsPassed}"/>
            <TextBlock Grid.Row="3"
                       Grid.Column="2"
                       Text="{Binding Type.Name}"/>
            <CheckBox Grid.Row="4"
                      Grid.Column="2"
                      IsEnabled="True"
                      IsChecked="{Binding IsLoto, Mode=TwoWay}"/>
            <CheckBox Grid.Row="5"
                      Grid.Column="2"
                      IsEnabled="True"
                      IsChecked="{Binding IsJog, Mode=TwoWay}"/>
            <CheckBox Grid.Row="6"
                      Grid.Column="2"
                      IsEnabled="True"
                      IsChecked="{Binding IsDurningProduction, Mode=TwoWay}"/>
            <TextBlock Grid.Row="7"
                       Grid.Column="2"
                       Text="{Binding OccuranceText}"/>
            <CheckBox Grid.Row="8"
                      Grid.Column="2"
                      IsEnabled="False"
                      IsChecked="{Binding HasInstruction}"/>

        </Grid>

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Szkolenia"
                       Grid.Row="0"
                       Style="{StaticResource TitleTextBlock}"/>

            <DataGrid Grid.Row="1"
                      Margin="20,0"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      Style="{DynamicResource DataGridMain}"
                      RowStyle="{StaticResource DataGridRowMain}"
                      CellStyle="{DynamicResource DataGridCellMain}"
                      ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderMain}"
                      ItemsSource="{Binding Path=Trainings}">

                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Trainee.FullName}"
                                        Header="Szkolony"
                                        Width="auto"/>

                    <DataGridTextColumn Binding="{Binding Coach.FullName}"
                                        Header="Szkolący"
                                        Width="auto"/>

                    <DataGridTextColumn Binding="{Binding TrainingDate}"
                                        Header="Szkolony"
                                        Width="auto"/>

                    <DataGridCheckBoxColumn Binding="{Binding IsConfirmedByTrainee}"
                                            Header="Potwierdził szkolony"
                                            Width="auto"/>

                    <DataGridCheckBoxColumn Binding="{Binding IsConfirmedByCoach}"
                                            Header="Potwierdził szkolący"
                                            Width="auto"/>

                    <DataGridTemplateColumn
                        Width="auto"
                        Header="Akcje"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <Button Command="{Binding Path=DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding }">

                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource gridConfirmButton}">

                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                                <Style.Triggers>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsConfirmedByCoach}"
                                                                       Value="False"/>
                                                            <Condition Binding="{Binding DataContext.IsViewedByCoach, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                       Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </MultiDataTrigger>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsConfirmedByTrainee}"
                                                                       Value="False"/>
                                                            <Condition Binding="{Binding IsViewedByTrainee}"
                                                                       Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </MultiDataTrigger>

                                                </Style.Triggers>


                                            </Style>
                                        </Button.Style>



                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource gridButtonIcon}"
                                            Text="&#xE930;"/>
                                    </Button>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>
        </Grid>



        <Grid Grid.Row="3">

            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Padding"
                            Value="5,15,5,20"/>
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1">
                <StackPanel Orientation="Horizontal">

                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin"
                                    Value="10,0"/>
                            <Setter Property="Height"
                                    Value="50"/>
                            <Setter Property="Width"
                                    Value="150"/>
                        </Style>
                    </StackPanel.Resources>

                    <Button
                        Style="{StaticResource ResourceKey=ButtonMain}"
                        Command="{Binding Path=EditCommand}"
                        Content="ZAPISZ"
                        Margin="10,0"
                        Height="50"
                        Width="150"/>

                    <Button
                        Style="{StaticResource ResourceKey=ButtonSide}"
                        Command="{Binding Path=ReturnCommand}"
                        Content="WRÓĆ"
                        Margin="10,0"
                        Height="50"
                        Width="150"/>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl> 