<UserControl
    x:Class="Shopfloor.Features.Actions.ActionTransfer.ActionTransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Shopfloor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shopfloor.Features.Actions.ActionTransfer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ActionTransferViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityReverseConverter x:Key="BooleanToVisibilityReverseConverter" />
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style BasedOn="{StaticResource TooltipText}" TargetType="{x:Type TextBlock}" />
            <Style BasedOn="{StaticResource CheckBoxStyle1}" TargetType="{x:Type CheckBox}" />
            <Style BasedOn="{StaticResource ComboBoxMain}" TargetType="{x:Type ComboBox}">
                <Setter Property="MinHeight" Value="28px" />
                <Setter Property="Width" Value="200px" />
            </Style>
            <Style BasedOn="{StaticResource TextBoxMain}" TargetType="{x:Type TextBox}">
                <Setter Property="MinWidth" Value="50px" />
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <Border Grid.Row="0">
            <TextBlock Style="{StaticResource TitleTextBlock}" Text="Przekazywanie działań" />
        </Border>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Obecny odpowiedzialny" />
                    <TextBlock
                        Margin="0,0,0,20"
                        Padding="0"
                        FontSize="22"
                        Foreground="{StaticResource BrushAccentPink500}"
                        Style="{StaticResource TitleTextBlock}"
                        Text="{Binding Activity.Workshop.Name}" />
                    <TextBlock Text="Przekaż do" />
                    <ComboBox
                        Width="300"
                        Margin="0,0,0,40"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Path=Workshops}"
                        SelectedItem="{Binding Path=SelectedWorkshop}" />
                </StackPanel>
            </Border>

            <Grid
                Grid.Row="1"
                Grid.Column="1"
                DataContext="{Binding Activity}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <Style BasedOn="{StaticResource TooltipText}" TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                    <Style BasedOn="{StaticResource CheckBoxStyle1}" TargetType="{x:Type CheckBox}" />
                </Grid.Resources>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3">
                    <TextBlock
                        Margin="0,0,0,10"
                        Padding="0"
                        Style="{StaticResource TitleTextBlock}"
                        Text="Szczegóły zadania" />
                </Border>

                <TextBlock
                    Grid.Row="8"
                    Grid.Column="0"
                    Text="Opis" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Rodzaj" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="LOTO" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Text="Tryb JOG" />
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Text="Podczas produkcji" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Text="Częstotliwość" />
                <TextBlock
                    Grid.Row="7"
                    Grid.Column="0"
                    Text="Instrukcja wykonania" />

                <TextBlock
                    Grid.Row="8"
                    Grid.Column="2"
                    Text="{Binding Description}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Text="{Binding Type.Name}" />
                <CheckBox
                    Grid.Row="3"
                    Grid.Column="2"
                    IsChecked="{Binding IsLoto}"
                    IsEnabled="False" />
                <CheckBox
                    Grid.Row="4"
                    Grid.Column="2"
                    IsChecked="{Binding IsJog, Mode=OneWay}"
                    IsEnabled="False" />
                <CheckBox
                    Grid.Row="5"
                    Grid.Column="2"
                    IsChecked="{Binding IsDurningProduction}"
                    IsEnabled="False" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="2"
                    Text="{Binding OccuranceText}" />
                <CheckBox
                    Grid.Row="7"
                    Grid.Column="2"
                    IsChecked="{Binding HasInstruction}"
                    IsEnabled="False" />
            </Grid>

            <Grid Grid.Row="1" Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <TextBlock
                        Margin="0,0,0,10"
                        Padding="0"
                        Style="{StaticResource TitleTextBlock}"
                        Text="Szkolenia" />
                </Border>

                <DataGrid
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding PeopleToTrain}">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding Responsible.FullName}"
                            Header="Osoba" />

                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding TrainingStatus}"
                            Header="Status" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="0,20,0,0">
                <TextBlock Text="Powody" />

                <ScrollViewer
                    MaxHeight="500"
                    CanContentScroll="True"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <TextBox
                        Width="650"
                        MinHeight="82"
                        Padding="5"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        Style="{StaticResource TextBoxMain}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Margin" Value="10,0" />
                        <Setter Property="Height" Value="50" />
                        <Setter Property="Width" Value="150" />
                    </Style>
                </StackPanel.Resources>

                <Button
                    Width="150"
                    Height="50"
                    Margin="10,0"
                    Command="{Binding Path=ReturnCommand}"
                    Content="PRZEKAŻ"
                    Style="{StaticResource ResourceKey=ButtonMain}"
                    Visibility="{Binding Path=IsEveryoneTrained, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button
                    Width="150"
                    Height="50"
                    Margin="10,0"
                    Command="{Binding Path=ReturnCommand}"
                    Content="PRZESZKÓL"
                    Style="{StaticResource ResourceKey=ButtonEmpty}"
                    Visibility="{Binding Path=IsEveryoneTrained, Converter={StaticResource BooleanToVisibilityReverseConverter}}" />

                <Button
                    Width="150"
                    Height="50"
                    Margin="10,0"
                    Command="{Binding Path=ReturnCommand}"
                    Content="WRÓĆ"
                    Style="{StaticResource ResourceKey=ButtonSide}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl> 