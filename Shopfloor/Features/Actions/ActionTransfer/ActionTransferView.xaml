<UserControl x:Class="Shopfloor.Features.Actions.ActionTransfer.ActionTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Shopfloor.Features.Actions.ActionTransfer"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style BasedOn="{StaticResource TooltipText}"
                   TargetType="{x:Type TextBlock}"/>
            <Style BasedOn="{StaticResource CheckBoxStyle1}"
                   TargetType="{x:Type CheckBox}"/>
            <Style BasedOn="{StaticResource ComboBoxMain}"
                   TargetType="{x:Type ComboBox}">
                <Setter Property="MinHeight"
                        Value="28px"/>
                <Setter Property="Width"
                        Value="200px"/>
            </Style>
            <Style BasedOn="{StaticResource TextBoxMain}"
                   TargetType="{x:Type TextBox}">
                <Setter Property="MinWidth"
                        Value="50px"/>
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>
                <Setter Property="BorderThickness"
                        Value="0"/>
            </Style>
        </Grid.Resources>

        <Border Grid.Row="0">
            <TextBlock Style="{StaticResource TitleTextBlock}"
                       Text="Przekazywanie działań"/>
        </Border>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0"
                        Grid.Column="1">
                <Label>
                    <TextBlock Text="Obecny odpowiedzialny"/>
                </Label>
                <TextBlock Text="{Binding Activity.Workshop.Name}"
                           Style="{StaticResource TitleTextBlock}"/>
            </StackPanel>

            <TextBlock Text="&#xE724;"
                       MinWidth="100"
                       FontSize="32"
                       Height="40"
                       Margin="30,0"
                       Grid.Row="0"
                       Grid.Column="2"
                       FontFamily="Segoe MDL2 Assets"
                       TextAlignment="Center"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Row="0"
                        Grid.Column="3">
                <Label>
                    <TextBlock Text="Nowy odpowiedzialny"/>
                </Label>
                <ComboBox/>
            </StackPanel>

            <Grid
                Grid.Row="1"
                Grid.Column="1"
                Margin="20,0,0,20"
                DataContext="{Binding Activity}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid.Resources>
                    <Style BasedOn="{StaticResource TooltipText}"
                           TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin"
                                Value="0,0,0,10"/>
                    </Style>
                    <Style BasedOn="{StaticResource CheckBoxStyle1}"
                           TargetType="{x:Type CheckBox}"/>
                </Grid.Resources>

                <Border Grid.Row="0">
                    <TextBlock Style="{StaticResource TitleTextBlock}"
                               Text="Szczegóły zadania"/>
                </Border>

                <TextBlock
                    Grid.Row="8"
                    Grid.Column="0"
                    Text="Opis"/>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Rodzaj"/>
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="LOTO"/>
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Text="Tryb JOG"/>
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Text="Podczas produkcji"/>
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Text="Częstotliwość"/>
                <TextBlock
                    Grid.Row="7"
                    Grid.Column="0"
                    Text="Instrukcja wykonania"/>

                <TextBlock
                    Grid.Row="8"
                    Grid.Column="2"
                    Text="{Binding Description}"/>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Text="{Binding Type.Name}"/>
                <CheckBox
                    Grid.Row="3"
                    Grid.Column="2"
                    IsChecked="{Binding IsLoto}"
                    IsEnabled="False"/>
                <CheckBox
                    Grid.Row="4"
                    Grid.Column="2"
                    IsChecked="{Binding IsJog, Mode=OneWay}"
                    IsEnabled="False"/>
                <CheckBox
                    Grid.Row="5"
                    Grid.Column="2"
                    IsChecked="{Binding IsDurningProduction}"
                    IsEnabled="False"/>
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="2"
                    Text="{Binding OccuranceText}"/>
                <CheckBox
                    Grid.Row="7"
                    Grid.Column="2"
                    IsChecked="{Binding HasInstruction}"
                    IsEnabled="False"/>
            </Grid>


            <Grid Grid.Row="1"
                  Column="3">

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0">
                    <TextBlock Style="{StaticResource TitleTextBlock}"
                               Text="Szkolenia"/>
                </Border>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding PeopleToTrain}">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding Responsible.FullName}"
                            Header="Osoba"/>

                        <DataGridTextColumn
                            Width="auto"
                            Binding="{Binding TrainingStatus}"
                            Header="Status"/>


                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

            <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="3">
                <TextBlock Text="Powody"/>

                <ScrollViewer MaxHeight="500"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="True"
                              HorizontalScrollBarVisibility="Disabled">

                    <TextBox Padding="5"
                             AcceptsReturn="True"
                             HorizontalContentAlignment="Left"
                             VerticalContentAlignment="Top"
                             Width="650"
                             MinHeight="82"
                             Style="{StaticResource TextBoxMain}"
                             TextWrapping="Wrap"/>
                </ScrollViewer>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        Grid.Column="1">

                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Margin"
                                Value="10,0"/>
                        <Setter Property="Height"
                                Value="50"/>
                        <Setter Property="Width"
                                Value="150"/>
                    </Style>
                </StackPanel.Resources>

                <Button
                    Width="150"
                    Height="50"
                    Margin="10,0"
                    Command="{Binding Path=ReturnCommand}"
                    Content="PRZEKAŻ"
                    Style="{StaticResource ResourceKey=ButtonMain}"/>

                <Button
                    Width="150"
                    Height="50"
                    Margin="10,0"
                    Command="{Binding Path=ReturnCommand}"
                    Content="PRZESZKÓL"
                    Style="{StaticResource ResourceKey=ButtonMain}"/>

                <Button
                    Width="150"
                    Height="50"
                    Margin="10,0"
                    Command="{Binding Path=ReturnCommand}"
                    Content="WRÓĆ"
                    Style="{StaticResource ResourceKey=ButtonSide}"/>

            </StackPanel>

        </Grid>
    </Grid>
</UserControl> 