<UserControl
    x:Class="Shopfloor.Features.MachineResponsibilities.MachineResponsibilitiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shopfloor.Features.MachineResponsibilities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:MachineResponsibilitiesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock
                    Margin="0,7,0,3"
                    Style="{StaticResource TooltipText}"
                    Text="Linia"/>

                <ComboBox
                    Grid.Row="0"
                    MinHeight="30px"
                    DisplayMemberPath="Name"
                    IsEditable="true"
                    IsReadOnly="false"
                    IsTextSearchEnabled="false"
                    ItemsSource="{Binding Path=Lines}"
                    SelectedItem="{Binding Path=SelectedLine}"
                    SelectedValuePath="Name"
                    Style="{StaticResource ComboBoxMain}"
                    Text="{Binding LineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,7,0,3"
                    Style="{StaticResource TooltipText}"
                    Text="Maszyna"/>
                <ScrollViewer Grid.Row="1"
                              PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                    <DataGrid
                        CellStyle="{DynamicResource DataGridCellMain}"
                        ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderMain}"
                        IsReadOnly="True"
                        ItemsSource="{Binding Path=Machines}"
                        RowStyle="{DynamicResource DataGridRowMain}"
                        SelectedItem="{Binding Path=SelectedMachine}"
                        Style="{DynamicResource DataGridMain}">
                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Width="auto"
                                Binding="{Binding Line.Name}"
                                Header="Linia"/>

                            <DataGridTextColumn
                                Width="auto"
                                Binding="{Binding Name}"
                                Header="Maszyna"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource TitleTextBlock}"
                Text="{Binding Title}"/>

            <StackPanel Grid.Row="1">
                <DataGrid ItemsSource="{Binding Path=SelectedMachine.Responsibles}">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=SelectedMachine}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
                <TextBlock Foreground="{StaticResource BrushAccentPink400}"
                           Text="{Binding Path=MissingWorkshops}"/>
            </StackPanel>

            <Grid
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2">

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility"
                                Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=SelectedMachine}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>


                <Grid.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Padding"
                                Value="5,15,5,20"/>
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1">
                    <StackPanel Orientation="Horizontal">

                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Margin"
                                        Value="10,0"/>
                                <Setter Property="Height"
                                        Value="50"/>
                                <Setter Property="Width"
                                        Value="150"/>
                            </Style>
                        </StackPanel.Resources>

                        <Button
                            Width="150"
                            Height="50"
                            Margin="10,0"
                            Command="{Binding Path=EditResponsibilitiesCommand}"
                            Content="ZMIEŃ"
                            Style="{StaticResource ResourceKey=ButtonMain}"/>

                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

    </Grid>

</UserControl> 