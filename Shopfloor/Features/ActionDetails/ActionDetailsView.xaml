<UserControl
    x:Class="Shopfloor.Features.ActionDetails.ActionDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Shopfloor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shopfloor.Features.ActionDetails"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ActionDetailsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ComparisonConverter x:Key="ComparisonConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlock}"
            Text="{Binding Title}" />

        <Grid
            Grid.Row="1"
            Margin="20,0,0,20"
            DataContext="{Binding Activity}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style BasedOn="{StaticResource TooltipText}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
                <Style BasedOn="{StaticResource CheckBoxStyle1}" TargetType="{x:Type CheckBox}" />
            </Grid.Resources>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="Warsztat" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="Opis" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Text="Przekazane" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Text="Rodzaj" />
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Text="LOTO" />
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Text="Tryb JOG" />
            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                Text="Podczas produkcji" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="0"
                Text="Częstotliwość" />
            <TextBlock
                Grid.Row="8"
                Grid.Column="0"
                Text="Instrukcja wykonania" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Text="{Binding Workshop.Name}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                Text="{Binding Description}" />
            <CheckBox
                Grid.Row="2"
                Grid.Column="2"
                IsChecked="{Binding IsPassed}"
                IsEnabled="False" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="2"
                Text="{Binding Type.Name}" />
            <CheckBox
                Grid.Row="4"
                Grid.Column="2"
                IsChecked="{Binding IsLoto}"
                IsEnabled="False" />
            <CheckBox
                Grid.Row="5"
                Grid.Column="2"
                IsChecked="{Binding IsJog, Mode=OneWay}"
                IsEnabled="False" />
            <CheckBox
                Grid.Row="6"
                Grid.Column="2"
                IsChecked="{Binding IsDurningProduction}"
                IsEnabled="False" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="2"
                Text="{Binding OccuranceText}" />
            <CheckBox
                Grid.Row="8"
                Grid.Column="2"
                IsChecked="{Binding HasInstruction}"
                IsEnabled="False" />
        </Grid>

        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource TitleTextBlock}"
                Text="Szkolenia" />

            <DataGrid
                Grid.Row="1"
                Margin="20,0"
                AutoGenerateColumns="False"
                CellStyle="{DynamicResource DataGridCellMain}"
                ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderMain}"
                IsReadOnly="True"
                ItemsSource="{Binding Path=Trainings}"
                RowStyle="{StaticResource DataGridRowMain}"
                Style="{DynamicResource DataGridMain}">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Trainee.FullName}"
                        Header="Szkolony" />

                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding Coach.FullName}"
                        Header="Szkolący" />

                    <DataGridTextColumn
                        Width="auto"
                        Binding="{Binding TrainingDate}"
                        Header="Szkolony" />

                    <DataGridCheckBoxColumn
                        Width="auto"
                        Binding="{Binding IsConfirmedByTrainee}"
                        Header="Potwierdził szkolony" />

                    <DataGridCheckBoxColumn
                        Width="auto"
                        Binding="{Binding IsConfirmedByCoach}"
                        Header="Potwierdził szkolący" />

                    <DataGridTemplateColumn
                        Width="auto"
                        Header="Akcje"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">

                                    <Button
                                        Command="{Binding Path=DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource gridConfirmButton}">

                                        <Button.Visibility>
                                            <MultiBinding Converter="{StaticResource ComparisonConverter}">
                                                <Binding Path="IsConfirmedByCoach" />
                                                <Binding Path="IsConfirmedByTrainee" />
                                                <Binding Path="Coach" />
                                                <Binding Path="Trainee" />
                                                <Binding Path="DataContext.CurrentPerson" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </Button.Visibility>

                                        <!--<Button.Style>
                                            <Style BasedOn="{StaticResource gridConfirmButton}" TargetType="Button">

                                                <Setter Property="Visibility" Value="Collapsed" />

                                                <Style.Triggers>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsConfirmedByCoach}" Value="False" />
                                                            <Condition Binding="{Binding DataContext.IsViewedByCoach, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsConfirmedByTrainee}" Value="False" />
                                                            <Condition Binding="{Binding IsViewedByTrainee, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>-->

                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource gridButtonIcon}"
                                            Text="&#xE930;" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="3">

            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="5,15,5,20" />
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1">
                <StackPanel Orientation="Horizontal">

                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="10,0" />
                            <Setter Property="Height" Value="50" />
                            <Setter Property="Width" Value="150" />
                        </Style>
                    </StackPanel.Resources>

                    <Button
                        Width="150"
                        Height="50"
                        Margin="10,0"
                        Command="{Binding Path=EditCommand}"
                        Content="EDYTUJ"
                        Style="{StaticResource ResourceKey=ButtonMain}" />

                    <Button
                        Width="150"
                        Height="50"
                        Margin="10,0"
                        Command="{Binding Path=ReturnCommand}"
                        Content="WRÓĆ"
                        Style="{StaticResource ResourceKey=ButtonSide}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl> 