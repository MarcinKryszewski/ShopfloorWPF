<UserControl x:Class="Shopfloor.Features.Trainings.ActionTraining.ActionTrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Shopfloor.Features.Trainings.ActionTraining"
             xmlns:action="clr-namespace:Shopfloor.Features.Trainings.ActionTraining.SelectAction"
             xmlns:person="clr-namespace:Shopfloor.Features.Trainings.ActionTraining.SelectPerson"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid>
        <ContentControl Content="{Binding ContentViewModel}"
                        Grid.Row="2">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type action:SelectActionViewModel}">
                    <action:SelectActionView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type person:SelectPersonViewModel}">
                    <person:SelectPersonView/>
                </DataTemplate>
            </ContentControl.Resources>

        </ContentControl>
    </Grid>
</UserControl>
