<UserControl
    x:Class="Shopfloor.Features.Trainings.ActionTrainingList.ActionTrainingListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shopfloor.Features.Trainings.ActionTrainingList"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <StackPanel Orientation="Horizontal">

            <StackPanel.Resources>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Margin" Value="10,0" />
                    <Setter Property="Height" Value="50" />
                    <Setter Property="Width" Value="150" />
                </Style>
            </StackPanel.Resources>

            <Button
                Width="150"
                Height="50"
                Margin="10,0"
                Command="{Binding Path=ReturnCommand}"
                Content="WRÓĆ"
                Style="{StaticResource ResourceKey=ButtonSide}" />
        </StackPanel>
    </Grid>
</UserControl> 