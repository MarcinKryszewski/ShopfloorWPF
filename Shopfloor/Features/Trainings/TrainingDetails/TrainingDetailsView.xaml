<UserControl
    x:Class="Shopfloor.Features.Trainings.TrainingDetails.TrainingDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shopfloor.Features.Trainings.TrainingDetails"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:TrainingDetailsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>

        <Grid.Resources>
            <Style BasedOn="{StaticResource ComboBoxMain}" TargetType="{x:Type ComboBox}" />
            <Style BasedOn="{StaticResource TooltipText}" TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="3,0,0,3" />
            </Style>
            <Style BasedOn="{StaticResource TextBoxMain}" TargetType="{x:Type TextBox}">
                <Setter Property="MinHeight" Value="40px" />
                <Setter Property="Width" Value="310px" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="IsEnabled" Value="False" />
            </Style>
            <Style BasedOn="{StaticResource {x:Type StackPanel}}" TargetType="{x:Type StackPanel}">
                <Setter Property="Margin" Value="0,5" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            Style="{StaticResource TitleTextBlock}"
            Text="{Binding Title}" />

        <StackPanel Grid.Row="3" Grid.Column="1">
            <TextBlock Text="Trener" />
            <TextBox Text="{Binding TrainerName, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1">
            <TextBlock Text="Data szkolenia" />
            <TextBox Text="{Binding TrainingDate, Mode=OneWay, StringFormat=yyyy-MM-dd}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="1">
            <TextBlock Text="Biorący udział w szkoleniu" />
            <ScrollViewer>
                <DataGrid Width="600" />
            </ScrollViewer>
        </StackPanel>

        <Grid
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="3">

            <Grid.Resources>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="5,15,5,20" />
                </Style>
            </Grid.Resources>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1">
                <StackPanel Orientation="Horizontal">

                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="10,0" />
                            <Setter Property="Height" Value="50" />
                            <Setter Property="Width" Value="150" />
                        </Style>
                    </StackPanel.Resources>

                    <Button
                        Width="150"
                        Height="50"
                        Margin="10,0"
                        Command="{Binding Path=EditNavigateCommand}"
                        Content="EDYTUJ"
                        Style="{StaticResource ResourceKey=ButtonMain}" />

                    <Button
                        Width="150"
                        Height="50"
                        Margin="10,0"
                        Command="{Binding Path=ReturnNavigateCommand}"
                        Content="WRÓĆ"
                        Style="{StaticResource ResourceKey=ButtonSide}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl> 