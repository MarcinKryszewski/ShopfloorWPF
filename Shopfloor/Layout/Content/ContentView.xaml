<UserControl
    x:Class="Shopfloor.Layout.Content.ContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:activitiesList="clr-namespace:Shopfloor.Features.ActionsList"
    xmlns:activityCreate="clr-namespace:Shopfloor.Features.Actions.ActionCreate"
    xmlns:activityDetails="clr-namespace:Shopfloor.Features.ActionDetails"
    xmlns:activityEdit="clr-namespace:Shopfloor.Features.ActionEdit"
    xmlns:content="clr-namespace:Shopfloor.Layout.Content"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:god="clr-namespace:Shopfloor.Features.God"
    xmlns:machineResponsibilities="clr-namespace:Shopfloor.Features.MachineResponsibilities"
    xmlns:machineResponsibilityEdit="clr-namespace:Shopfloor.Features.MachineResponsibilityEdit"
    xmlns:personalTraining="clr-namespace:Shopfloor.Features.Personal.PersonalTraining"
    xmlns:trainingCreate="clr-namespace:Shopfloor.Features.TrainingFeatures.TrainingCreate"
    xmlns:trainingDetails="clr-namespace:Shopfloor.Features.TrainingFeatures.TrainingDetails"
    xmlns:actionTrainingList="clr-namespace:Shopfloor.Features.Trainings.ActionTrainingList"
    xmlns:actionTransfer="clr-namespace:Shopfloor.Features.Action.ActionTransfer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:topPanel="clr-namespace:Shopfloor.Layout.TopPanel"
    xmlns:wip="clr-namespace:Shopfloor.Features.WorkInProgressFeature"
    d:DataContext="{d:DesignInstance Type=content:ContentViewModel}"
    d:Height="1020"
    d:Width="1680"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <topPanel:TopPanelView Grid.Row="0"
                               DataContext="{Binding TopPanelViewModel}"/>
        <Border Grid.Row="1"
                Background="{StaticResource BrushDarkNeutral100}">
            <ContentControl Content="{Binding Content}"
                            ContentTemplateSelector="{Binding TemplateSelector}"/>
        </Border>
    </Grid>
</UserControl>